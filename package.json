{
  "name": "notes",
  "version": "1.0.0",
  "private": true,
  "description": "My Note - notes, reminders, voice typing, Turso backup. Static web app (www/) wrapped with Capacitor for Android.",
  "scripts": {
    "serve": "http-server www -p 5173 -c-1 --silent",
    "test": "node tests/smoke.js",
    "assets": "capacitor-assets generate --android",
    "sync": "cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "http-server": "^14.1.1",
    "playwright": "^1.50.0"
  },
  "dependencies": {
    "@capgo/capacitor-navigation-bar": "^7.3.18"
  }
}
