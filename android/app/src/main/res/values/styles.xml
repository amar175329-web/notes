<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="isLightTheme">true</item>
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="colorAccent">@color/teal_primary</item>
        <item name="android:textColorPrimary">@color/dark_ink</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorPrimaryInverse">@color/white</item>
        <item name="actionMenuTextColor">@color/dark_ink</item>
        <item name="android:actionMenuTextColor">@color/dark_ink</item>
        <item name="actionModeStyle">@style/AppTheme.ActionMode</item>
        <item name="android:actionModeStyle">@style/AppTheme.ActionMode</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:colorBackgroundFloating">@color/white</item>
        <item name="colorBackgroundFloating">@color/white</item>
        <item name="android:popupBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="isLightTheme">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:textColorPrimary">@color/dark_ink</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorPrimaryInverse">@color/white</item>
        <item name="actionMenuTextColor">@color/dark_ink</item>
        <item name="android:actionMenuTextColor">@color/dark_ink</item>
        <item name="actionModeStyle">@style/AppTheme.ActionMode</item>
        <item name="android:actionModeStyle">@style/AppTheme.ActionMode</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:colorBackgroundFloating">@color/white</item>
        <item name="colorBackgroundFloating">@color/white</item>
        <item name="android:popupBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.ActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">@color/white</item>
        <item name="android:background">@color/white</item>
        <item name="titleTextStyle">@style/AppTheme.ActionMode.Title</item>
        <item name="subtitleTextStyle">@style/AppTheme.ActionMode.Title</item>
        <item name="actionMenuTextColor">@color/dark_ink</item>
        <item name="android:actionMenuTextColor">@color/dark_ink</item>
    </style>

    <style name="AppTheme.ActionMode.Title" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">@color/dark_ink</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
